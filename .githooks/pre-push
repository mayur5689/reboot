#!/bin/sh
# Block direct pushes to main/master — use feature branches + PRs instead.

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo ""
      echo "Push blocked: direct pushes to main/master are not allowed."
      echo "Work on a feature branch and open a pull request."
      echo ""
      exit 1
      ;;
  esac
done

exit 0
